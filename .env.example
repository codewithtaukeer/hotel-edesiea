# -------------------------------------------------------------
# HOTEL EDESIEA — ENVIRONMENT VARIABLES
# -------------------------------------------------------------

# --- DATABASE CONFIGURATION ---
# Option A: Local Development (Default SQLite)
DATABASE_URL="file:./dev.db"

# Option B: Cloud Production (Supabase PostgreSQL)
# 1. DATABASE_URL: Transaction Pooler connection string (Port 6543, pgbouncer=true)
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# 2. DIRECT_URL: Direct session connection string for Prisma migrations (Port 5432)
# DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- SUPABASE REST & CLIENT ACCESS ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-jwt-token-here"

# --- AUTHENTICATION & SECURITY ---
# Secure random string used to sign session tokens for 8 hotel staff roles
AUTH_SECRET="edesiea_hotel_jwt_secure_secret_pali_2026_super_key"

# --- VERIFIED HOTEL BUSINESS METADATA ---
NEXT_PUBLIC_HOTEL_NAME="Hotel Edesiea"
NEXT_PUBLIC_HOTEL_PHONE="+91 8855887673"
NEXT_PUBLIC_HOTEL_WHATSAPP="918855887673"
NEXT_PUBLIC_HOTEL_EMAIL="taukeerakbar.code@mail.com"
NEXT_PUBLIC_HOTEL_ADDRESS="Hotel Edesiea, Pure Veg Restaurant & Stay, Near Shree Ballaleshwar Ganpati Temple, Pali, Raigad, Maharashtra 410205"
NEXT_PUBLIC_HOTEL_MAPS_URL="https://maps.app.goo.gl/ZKSFVCUsSZ62sFuu8"

# --- RAZORPAY PAYMENT GATEWAY ---
# Production / Test API keys from Razorpay Dashboard (https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# --- ENVIRONMENT ---
NODE_ENV="development"
